PUID=1000
PGID=1000
TZ=Africa/Cairo
CONFIG_ROOT=./config
MEDIA_ROOT=/media/dell/Data/netfelix_data
# Optional if qBittorrent requires authentication from localhost:
QBT_USERNAME=
QBT_PASSWORD=
# Server-side title-to-download lookup for Jellyseerr's Watch now button:
JELLYSEERR_API_KEY=
RADARR_API_KEY=
SONARR_API_KEY=
BAZARR_API_KEY=
# Optional Usenet/SABnzbd integration. Start it with: docker compose --profile usenet up -d sabnzbd
SABNZBD_API_KEY=
# Optional webhook for health notifications (Discord/ntfy-compatible gateway, if used):
NETFELIX_NOTIFY_URL=
# Optional destination for local encrypted/offline backups:
BACKUP_ROOT=./backups
