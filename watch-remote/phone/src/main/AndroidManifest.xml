<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries><package android:name="com.carriez.flutter_hbb" /></queries>
    <application android:label="NetFelix Companion" android:icon="@drawable/ic_companion"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true" android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:supportsRtl="true">
        <activity android:name=".LaptopsActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="screenLayout|orientation|screenSize|keyboard|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
