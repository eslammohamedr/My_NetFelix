<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.type.watch" />
    <application android:label="NetFelix Remote" android:icon="@drawable/ic_remote" android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true" android:allowBackup="false">
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />
        <activity android:name=".DirectionActivity" android:exported="true" android:taskAffinity="com.netfelix.watch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".TouchActivity" android:exported="false" android:taskAffinity="com.netfelix.watch" />
    </application>
</manifest>
